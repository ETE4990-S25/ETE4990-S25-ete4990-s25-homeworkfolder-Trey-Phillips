import logging
import logging.handlers
import json
import re

#Part 1 Create Log Files
logger = logging.getLogger("Lab9Logger")
logger.setLevel(logging.DEBUG)
log_file_name = "Lab9Logger.log"

formatter = logging.Formatter(
    fmt = "%(asctime)s | %(name)s | %(levelname)s | %(message)s",
)

handler = logging.handlers.TimedRotatingFileHandler(
    filename = log_file_name,
    when="D",
    backupCount = 3,
)
handler.setFormatter(formatter)
logger.handlers.clear()
logger.addHandler(handler)

def create_logs(): #I used the 5 example logs for the names and then asked chatgpt to create the outputs for each
    open(log_file_name, 'w').close()
    logs = {
        "Lab9Logger.sqldb": [
            ("info", "Database connection established"),
            ("warning", "Database query took longer than expected"),
            ("error", "Database corruption detected"),
            ("critical", "System failure: Database crashed"),
        ],
        "Lab9Logger.ui": [
            ("info", "UI components loaded successfully"),
            ("warning", "UI element is missing on the page"),
            ("error", "Failed to render UI"),
            ("critical", "UI crash detected"),
        ],
        "Lab9Logger.frontend.js": [
            ("info", "Frontend script loaded"),
            ("warning", "Frontend script is deprecated"),
            ("error", "Error in frontend.js script"),
            ("critical", "Frontend crash: JavaScript engine failure"),
        ],
        "Lab9Logger.backend.js": [
            ("info", "Backend.js API request received"),
